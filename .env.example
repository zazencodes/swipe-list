# Neon variables come from `npx neon checkout <branch>` / `npx neon env pull`:
# DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_BRANCH, NEON_AUTH_BASE_URL,
# NEON_AUTH_JWKS_URL, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY,
# AWS_ENDPOINT_URL_S3, AWS_REGION

# App variables (all required)
AUTH_COOKIE_SECRET=        # openssl rand -base64 32
OWNER_EMAILS=you@example.com   # comma-separated; the only accounts that can sign in to the dashboard
MEDIA_BUCKET=media
HOST=127.0.0.1
DASHBOARD_PORT=9021        # dashboard + login + API (private network only in production)
AGENT_PORT=9022            # credential-only API + client downloads (public through Caddy in production)
AGENT_URL=http://localhost:9022            # public URL of the agent listener
DASHBOARD_URL=http://localhost:5173        # where you open the dashboard
