{
  "name": "swipe-list",
  "version": "0.1.0",
  "description": "Swipe List: inspiration queue, ingestion worker, searchable library, CLI, dashboard and agent skill",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env.local --import tsx --watch src/server/index.ts",
    "admin": "node --env-file=.env.local --import tsx src/server/admin.ts",
    "worker": "node --import tsx src/worker/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "dev:web": "vite",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "swipe": "node --import tsx src/cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@neon/config": "^1.9.4",
    "@neondatabase/auth": "^0.7.0-beta",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "hono": "^4.13.21",
    "input-otp": "^1.5.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "neon": "^8.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "$zod",
    "better-auth": "1.7.27",
    "@better-auth/core": "1.7.27"
  }
}
