# Copy to deploy.env (git-ignored) and fill in. Read by scripts/deploy.sh.
DEPLOY_HOST=root@203.0.113.10   # ssh target of your server
API_DOMAIN=swipe-api.example.com  # public hostname of the agent API; its DNS A record points at the server
DASHBOARD_PORT=9021             # must match the server's .env
AGENT_PORT=9022                 # must match the server's .env
